# ====================================================================
# CLOUDFLARE PAGES SECURITY HEADERS & CDN CACHE CONFIGURATION
# ====================================================================

# Global security headers for all routes
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://www.gstatic.com https://www.google.com https://apis.google.com https://www.recaptcha.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' https: data: blob:; connect-src 'self' https://*.googleapis.com https://*.firebaseio.com wss://*.firebaseio.com https://*.cloudflare.com https://*.workers.dev https://*.pages.dev https://securetoken.googleapis.com; frame-src https://*.firebaseapp.com https://www.google.com https://www.recaptcha.net; worker-src 'self' blob:; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload

# HTML no-cache to ensure users get the latest app version immediately
/
  Cache-Control: no-cache, no-store, must-revalidate

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Images & branding revalidation (ensures logos & favicons update instantly)
/images/*
  Cache-Control: public, max-age=0, must-revalidate

/favicon*
  Cache-Control: public, max-age=0, must-revalidate

# Static assets caching on Cloudflare CDN Edge
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# API CORS & no-cache headers
/api/*
  Cache-Control: no-store, no-cache, must-revalidate, proxy-revalidate, no-transform
  X-Accel-Buffering: no
