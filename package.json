{
  "name": "tiklive-agency",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build --configLoader runner",
    "typecheck": "tsc --noEmit",
    "typecheck:worker": "tsc --noEmit -p tsconfig.json",
    "test:rag": "node scripts/test_rag.cjs",
    "test:offline": "npm run test:offline:191",
    "test:offline:191": "node scripts/test_offline_191.cjs",
    "test:offline:200": "node scripts/test_offline_191.cjs",
    "test:muse": "node scripts/test_muse_request.cjs",
    "test:chat-client": "node scripts/test_chat_client.cjs",
    "test:chat-progress": "node scripts/test_chat_progress.cjs",
    "test:homepage": "node scripts/test_homepage_tax.cjs",
    "test:registration": "node scripts/test_registration_guide.cjs && node scripts/test_registration_tax_guide.cjs",
    "test:registration-advisor": "node scripts/test_registration_advisor.cjs",
    "test:registration-wizard": "node scripts/test_registration_wizard.cjs",
    "test:registration-industry": "node scripts/test_registration_industry.cjs",
    "test:scenario-recovery": "node scripts/test_scenario_recovery.cjs",
    "test:business-cessation": "node scripts/test_business_cessation.cjs",
    "test:rag-expansion": "node scripts/test_rag_expansion.cjs",
    "test:request-claims": "node scripts/test_request_claim_pipeline.cjs",
    "test:upgrade:offline": "npm run test:offline:191 && node scripts/test_upgrade_regression_offline.cjs",
    "test:scope": "node scripts/test_answer_scope.cjs",
    "test:abc": "node scripts/test_abc_groups.cjs",
    "test:decision": "node scripts/lint_rules.cjs && node scripts/test_chunk_meta.cjs && node scripts/test_decision_frame.cjs && node scripts/test_l2_gate.cjs && node scripts/test_rules_equivalence.cjs && node scripts/test_validator.cjs && node scripts/test_transport_parity.cjs && node scripts/test_42_cases.cjs && node scripts/test_retrieval_parity.cjs && node scripts/test_classification_floors.cjs && node scripts/test_answer_tone.cjs && node scripts/test_abc_groups.cjs",
    "test:scope:live": "node scripts/test_chat_scope_live.cjs",
    "kb:build": "node scripts/build_rag_db.js",
    "kb:check": "node scripts/verify_kb_sync.cjs",
    "kb:graph": "node scripts/build_legal_graph.cjs",
    "test:assurance": "node scripts/test_source_links.cjs && node scripts/test_legal_assurance.cjs",
    "kb:sources:check": "node scripts/test_source_links.cjs",
    "test:pipeline-audit": "node scripts/test_pipeline_audit.cjs",
    "test:question-purpose": "node scripts/test_question_purpose.cjs",
    "test:architecture": "node scripts/test_architecture_integrity.cjs",
    "test:source-routing": "node scripts/test_source_routing_regressions.cjs",
    "test:semantic-scope": "node scripts/test_semantic_scope_regressions.cjs",
    "test:required-evidence": "node scripts/test_required_evidence.cjs",
    "test:period-evidence": "node scripts/test_period_evidence_recovery.cjs",
    "test:grounded-calculation": "node scripts/test_grounded_calculation_recovery.cjs",
    "test:business-subject": "node scripts/test_business_subject_boundary.cjs",
    "kb:backfill": "node scripts/backfill_vectorize.mjs",
    "test:retrieval": "node scripts/test_retrieval_parity.cjs",
    "preview": "vite preview",
    "d1:migrate": "wrangler d1 execute tax_db --remote --config worker/wrangler.toml --file=./d1/schema.sql",
    "d1:migrate:local": "wrangler d1 execute tax_db --local --config worker/wrangler.toml --file=./d1/schema.sql",
    "d1:seed": "wrangler d1 execute tax_db --remote --config worker/wrangler.toml --file=./d1/seed.sql",
    "d1:seed:local": "wrangler d1 execute tax_db --local --config worker/wrangler.toml --file=./d1/seed.sql",
    "worker:deploy": "wrangler deploy --config worker/wrangler.toml",
    "pages:deploy": "npm run build && npx wrangler pages deploy dist --project-name=tax-hkd",
    "deploy:all": "npm run build && npm run worker:deploy && npx wrangler pages deploy dist --project-name=tax-hkd"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "firebase": "^13.0.0",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.475.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-tools": "^15.33.0",
    "tailwindcss": "^4.0.6",
    "typescript": "~5.7.2",
    "vite": "^6.1.0",
    "wrangler": "^4.149.0"
  }
}
